# =============================================================================
# 4FMOTORS CRM — variáveis de ambiente
# =============================================================================
# Copie para .env.local e preencha. NUNCA versione o arquivo preenchido.

# --- Supabase (público, vai para o navegador) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (servidor) ------------------------------------------------------
# IGNORA RLS. Só no servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta WhatsApp Cloud API --------------------------------------------------
# App Secret: usado para validar a assinatura X-Hub-Signature-256 dos webhooks.
# Sem ele, o webhook rejeita tudo — é assim de propósito.
META_APP_SECRET=

# Token de verificação: valor arbitrário que você repete no painel da Meta ao
# cadastrar a URL do webhook (https://SEU-DOMINIO/api/whatsapp/webhook).
META_WEBHOOK_VERIFY_TOKEN=

# Versão da Graph API. Atualize com intenção, não automaticamente.
META_GRAPH_API_VERSION=v21.0

# Os tokens de acesso de cada número NÃO ficam aqui: são cadastrados pela tela
# Configurações · WhatsApps e guardados em whatsapp_account_secrets, tabela sem
# política de leitura (acessível somente pelo service_role).
